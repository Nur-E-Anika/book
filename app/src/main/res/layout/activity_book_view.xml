<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/background_dark"
    tools:context="com.example.anan.project.bookView">

    <TextView
        android:id="@+id/readTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="false"
        android:layout_alignStart="@+id/wtrTextView"
        android:layout_marginTop="47dp"
        android:background="@android:drawable/button_onoff_indicator_off"
        android:fontFamily="casual"
        android:padding="@dimen/fui_button_inset_bottom"
        android:text="READ"
        android:textAppearance="@android:style/TextAppearance.Material.Button"
        android:textColor="@android:color/background_dark"
        android:textSize="15dp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/wtrTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_below="@+id/readTextView"
        android:layout_marginEnd="21dp"
        android:layout_marginTop="18dp"
        android:textStyle="bold"
        android:background="@android:drawable/button_onoff_indicator_off"
        android:fontFamily="casual"
        android:padding="@dimen/fui_button_inset_bottom"
        android:text="WANT TO READ"
        android:textAppearance="@android:style/TextAppearance.Material.Button"
        android:textColor="@android:color/background_dark"
        android:textSize="15dp"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="163dp" />

    <TextView
        android:id="@+id/favTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@+id/wtrTextView"
        android:layout_below="@+id/wtrTextView"
        android:layout_marginTop="22dp"
        android:textStyle="bold"
        android:background="@android:drawable/button_onoff_indicator_off"
        android:fontFamily="casual"
        android:padding="@dimen/fui_button_inset_bottom"
        android:text="FAVOURITE"
        android:textAppearance="@android:style/TextAppearance.Material.Button"
        android:textColor="@android:color/background_dark"
        android:textSize="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.338" />

    <RatingBar
        android:id="@+id/ratingBarBtn"
        style="@android:style/Widget.Material.RatingBar.Indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_below="@+id/favTextView"
        android:layout_marginStart="33dp"
        android:layout_marginTop="19dp"
        android:isIndicator="true"
        android:numStars="1"
        android:rating="1" />

    <TextView
        android:id="@+id/avgRatingTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/ratingBarBtn"
        android:layout_marginStart="5dp"
        android:layout_toEndOf="@+id/ratingBarBtn"
        android:textAppearance="@android:style/TextAppearance.Material.Widget.Button"
        android:textColor="@android:color/background_light" />


    <RatingBar
        android:id="@+id/ratingBar"
        style="@android:style/Widget.Holo.Light.RatingBar.Indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/ratingBarBtn"
        android:layout_marginStart="47dp"
        android:layout_toEndOf="@+id/avgRatingTextView"
        android:isIndicator="true"
        android:numStars="1"
        android:rating="0" />

    <TextView
        android:id="@+id/ratTaxtView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/avgRatingTextView"
        android:layout_alignBottom="@+id/avgRatingTextView"
        android:layout_alignStart="@+id/ratingBar"
        android:layout_marginStart="37dp"
        android:textColor="@android:color/background_light" />

    <Button
        android:id="@+id/cmntBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="13dp"
        android:background="@android:drawable/button_onoff_indicator_on"
        android:text="Add a comment"
        android:textAppearance="@android:style/TextAppearance.Holo.Widget.ActionBar.Title" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_above="@+id/cmntBtn"
        android:layout_alignParentStart="true"
        android:layout_margin="5dp"
        android:background="@android:color/background_dark">

        <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/layout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/layout1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?android:attr/scrollbarSize"
                android:orientation="vertical"
                android:paddingBottom="@dimen/cardview_default_radius">

                <TextView
                    android:id="@+id/nameTextview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:fontFamily="casual"
                    android:padding="3dp"
                    android:text="No Data Available..."
                    android:textColor="@android:color/background_light"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/plotTextview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:fontFamily="casual"
                    android:padding="3dp"
                    android:text="No Data Available..."
                    android:textColor="@android:color/background_light"
                    android:textStyle="bold" />

            </LinearLayout>
        </RelativeLayout>

    </ScrollView>

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="199dp"
        android:layout_height="169dp"
        android:layout_alignParentTop="true"
        android:layout_alignStart="@+id/scrollView"
        android:layout_marginStart="13dp"
        android:layout_marginTop="17dp" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/wtrTextView"
        android:layout_toStartOf="@+id/wtrTextView"
        app:srcCompat="@android:drawable/ic_input_add" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/favTextView"
        android:layout_toStartOf="@+id/favTextView"
        app:srcCompat="@android:drawable/star_big_on" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/wtrTextView"
        android:layout_toStartOf="@+id/readTextView"
        app:srcCompat="@drawable/fui_done_check_mark" />

</RelativeLayout>
